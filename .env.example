# 聊天模型与 Responses API
API_KEY=replace-with-chat-api-key
BASE_URL=https://example.com/v1
MODEL_NAME=replace-with-chat-model

# 长期记忆 Embedding（本地 Ollama）
EMBEDDING_API_KEY=ollama
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=512
EMBEDDING_PROVIDER=ollama
EMBEDDING_VERSION=1
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_MAX_RETRIES=1

# 可选：真实 Memory 集成测试。普通单元测试不要求启动这些服务。
BIT_AGENT_TEST_REDIS_URL=redis://127.0.0.1:6380/0
BIT_AGENT_TEST_POSTGRES_DSN=postgresql://bit_agent_test:bit_agent_test@127.0.0.1:55432/bit_agent_test
BIT_AGENT_TEST_LLM=1

# 默认使用本地执行进程和 SQLite，无需启动 Redis。
BIT_AGENT_RUNTIME=local
# 可选：更改会话保存目录。默认 Windows 用户的 LocalAppData/BitAgent/runtime。
# BIT_AGENT_DATA_DIR=D:/BitAgentData
# 可选：指定 Python；不填时优先使用项目 .venv。
# BIT_AGENT_PYTHON=D:/path/to/python.exe

# 旧 Redis 模式仅在 BIT_AGENT_RUNTIME=redis 时使用，需要另开旧 Worker。
BIT_AGENT_REDIS_URL=redis://127.0.0.1:6379/0
BIT_AGENT_WORKER_ID=local-worker
BIT_AGENT_TASK_TIMEOUT_SECONDS=3600
BIT_AGENT_SANDBOX_IMAGE=bit-agent-python-sandbox:0.1.0
BIT_AGENT_AUTO_ENVIRONMENT=1
HOST=127.0.0.1
PORT=3000

# 可选：Gateway/Worker 真实 Redis 集成测试
BIT_AGENT_TEST_TASK_REDIS_URL=redis://127.0.0.1:6381/0

# Agent 运行时 Context Manager（应按实际模型窗口调整）
# 直连大窗口模型可用 128000；有超时限制的中转站建议从 48000 起步。
CONTEXT_WINDOW_TOKENS=48000
CONTEXT_RESERVED_OUTPUT_TOKENS=8000
CONTEXT_TARGET_RATIO=0.60
CONTEXT_SOFT_LIMIT_RATIO=0.75
CONTEXT_HARD_LIMIT_RATIO=0.90
CONTEXT_RECENT_GROUPS=8
CONTEXT_MINIMUM_RECENT_GROUPS=2
CONTEXT_ARTIFACT_TRIGGER_TOKENS=4000
CONTEXT_INLINE_TOOL_OUTPUT_TOKENS=1200
CONTEXT_SUMMARIZATION_INPUT_TOKENS=24000
CONTEXT_SUMMARY_TOKENS=4000
